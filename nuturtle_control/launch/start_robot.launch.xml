<launch>
    <arg name="cmd_src" default="none">
        <choice value="circle"/>
        <choice value="teleop"/>
        <choice value="none"/>
    </arg>
    <arg name="robot" default="nusim">
        <choice value="nusim"/>
        <choice value="localhost"/>
        <choice value="none"/>
    </arg>
    <arg name="use_rviz" default="true" description="Controls whether Rviz is launched"/>

    <node pkg="nuturtle_control" exec="circle" if="$(eval '\'$(var cmd_src)\'== \'circle\'')"/>
    <!-- <node pkg="teleop_twist_keyboard" exec="teleop_twist_keyboard" if="$(eval '\'$(var cmd_src)\'== \'teleop\'')"/> -->

    

    <group if="$(eval '\'$(var robot)\' == \'nusim\'')">
        <include file="$(find-pkg-share nusim)/launch/nusim.launch.xml">
            <arg name="use_rviz" value="false"/>
            <arg name="use_jsp" value="false"/>
            <arg name="world_config" value="circle_world.yaml"/>
        </include>

        <node pkg="nuturtle_control" exec="turtle_control" >
            <param from="$(find-pkg-share nuturtle_description)/config/diff_params.yaml"/>
            <remap from="wheel_cmd" to="red/wheel_cmd"/>
            <remap from="sensor_data" to="red/sensor_data"/>
            <remap from="joint_states" to="blue/joint_states"/>
        </node>

        <node pkg="nuturtle_control" exec="odometry" >
            <param name="body_id" value="blue/base_footprint"/>
            <param name="odom_id" value="odom"/>
            <param name="wheel_left" value="wheel_left_joint"/>
            <param name="wheel_right" value="wheel_right_joint"/>

            <param name="track" value="0.16"/>
            <param name="radius" value="0.033"/>
            <remap from="joint_states" to="red/joint_states"/>
        </node>

        <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
            <arg name="use_jsp" value="false"/>
            <arg name="use_rviz" value="false"/>
            <arg name="color" value="blue"/>
        </include>

        <node pkg="tf2_ros" exec="static_transform_publisher"
        args="0 0 0 0 0 0 nusim/world odom"/>
        <node pkg="rviz2" exec="rviz2" args="-d $(find-pkg-share nusim)/config/control.rviz" on_exit="shutdown"/>
    </group>

    <group if="$(eval '\'$(var robot)\' == \'localhost\'')">
        <node pkg="nuturtle_control" exec="turtle_control">
            <param from="$(find-pkg-share nuturtle_description)/config/diff_params.yaml"/>
            <remap from="wheel_cmd" to="wheel_cmd"/>
            <remap from="sensor_data" to="sensor_data"/>
            <remap from="joint_states" to="blue/joint_states"/>
        </node>

        <node pkg="nuturtle_control" exec="odometry" name="odometry">
            <param name="body_id" value="blue/base_footprint"/>
            <param name="odom_id" value="odom"/>
            <param name="wheel_left" value="wheel_left_joint"/>
            <param name="wheel_right" value="wheel_right_joint"/>
            <param name="track" value="0.16"/>
            <param name="radius" value="0.033"/>
            <remap from="joint_states" to="blue/joint_states"/>
        </node>

        <node pkg="numsr_turtlebot" exec="numsr_turtlebot"/>

        
    </group>


    
</launch>