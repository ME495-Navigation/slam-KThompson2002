<launch>
    <arg name="robot" default="nusim">
        <choice value="nusim"/>
        <choice value="localhost"/>
        <choice value="none"/>
    </arg>

    <group if="$(eval '\'$(var robot)\' == \'nusim\'')">

        <include file="$(find-pkg-share nusim)/launch/nusim.launch.xml">
            <arg name="use_rviz"     value="false"/>
            <arg name="use_jsp"      value="false"/>
            <arg name="world_config" value="data_world.yaml"/>
        </include>

        <node pkg="nuturtle_control" exec="turtle_control">
            <param from="$(find-pkg-share nuturtle_description)/config/diff_params.yaml"/>
            <remap from="wheel_cmd"    to="red/wheel_cmd"/>
            <remap from="sensor_data"  to="red/sensor_data"/>
            <remap from="joint_states" to="green/joint_states"/>
        </node>

        <node pkg="nuturtle_control" exec="odometry" name="odometry">
            <param from="$(find-pkg-share nuturtle_description)/config/diff_params.yaml"/>
            <param name="body_id"     value="green/base_footprint"/>
            <param name="odom_id"     value="odom"/>
            <param name="wheel_left"  value="wheel_left_joint"/>
            <param name="wheel_right" value="wheel_right_joint"/>
            <remap from="joint_states" to="red/joint_states"/>
            <remap from="nav_path"     to="green/nav_path"/>
        </node>

        <node pkg="nuturtle_control" exec="odometry" name="odometry_blue">
            <param from="$(find-pkg-share nuturtle_description)/config/diff_params.yaml"/>
            <param name="body_id"     value="blue/base_footprint"/>
            <param name="odom_id"     value="nusim/world"/>
            <param name="wheel_left"  value="wheel_left_joint"/>
            <param name="wheel_right" value="wheel_right_joint"/>
            <remap from="joint_states" to="red/joint_states"/>
            <remap from="nav_path"     to="blue/nav_path"/>
        </node>

        <!-- New landmark node -->
        <node pkg="nuslam" exec="landmark" name="landmark">
            <param name="cluster_threshold" value="0.1"/>
            <param name="min_cluster"       value="4"/>
            <param name="min_radius"        value="0.08"/>
            <param name="max_radius"        value="0.12"/>
            <param name="min_angle"         value="1.5"/>
            <param name="max_angle"         value="2.5"/>
        </node>

        <node pkg="nuslam" exec="slam_data" name="slam">
            <param from="$(find-pkg-share nuturtle_description)/config/diff_params.yaml"/>
            <param name="body_id"       value="red/base_footprint"/>
            <param name="odom_id"       value="odom"/>
            <param name="wheel_left"    value="wheel_left_joint"/>
            <param name="wheel_right"   value="wheel_right_joint"/>
            <param name="sensing_noise"          value="0.001"/>
            <param name="threshold"              value="20.0"/>
            <param name="min_observations"       value="3"/>
            <param name="provisional_match_dist" value="0.2"/>
            <param name="max_provisional_age"    value="5"/>
            <remap from="joint_states"  to="red/joint_states"/>
            <remap from="landmark_pub"  to="/landmark/landmark_pub"/>
        </node>

        <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
            <arg name="color"    value="blue"/>
            <arg name="use_jsp"  value="true"/>
            <arg name="use_rviz" value="false"/>
        </include>

        <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
            <arg name="color"    value="green"/>
            <arg name="use_jsp"  value="false"/>
            <arg name="use_rviz" value="false"/>
        </include>

        <node pkg="tf2_ros" exec="static_transform_publisher"
              args="0 0 0 0 0 0 nusim/world map"/>

        <node pkg="rviz2" exec="rviz2"
              args="-d $(find-pkg-share nuslam)/config/slam_data.rviz"
              on_exit="shutdown"/>

    </group>
</launch>
