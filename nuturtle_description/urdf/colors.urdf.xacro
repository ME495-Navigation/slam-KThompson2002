<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <material name="green">
         <color rgba="0 1 0 1" />
    </material>

    <material name="red">
        <color rgba="1 0 0 1" />
    </material>

    <material name="purple">
        <color rgba="0.3 0.16 0.52 1"/>
    </material>

    <material name="blue">
        <color rgba="0 0 1 1"/>
    </material>
</robot>