<launch>
    <include file="$(find-pkg-share nuturtle_description/launch/load_one.launch.xml">
         <arg name="use_jsp" value="true"/>
         <arg name="use_rviz" value="false"/>
         <arg name="color" value="purple"/>
    </include>

    <include file="$(find-pkg-share nuturtle_description/launch/load_one.launch.xml">
         <arg name="use_jsp" value="true"/>
         <arg name="use_rviz" value="false"/>
         <arg name="color" value="red"/>
    </include>

    <include file="$(find-pkg-share nuturtle_description/launch/load_one.launch.xml">
         <arg name="use_jsp" value="true"/>
         <arg name="use_rviz" value="false"/>
         <arg name="color" value="green"/>
    </include>

    <include file="$(find-pkg-share nuturtle_description/launch/load_one.launch.xml">
         <arg name="use_jsp" value="true"/>
         <arg name="use_rviz" value="false"/>
         <arg name="color" value="blue"/>
    </include>

    <node pkg="tf2_ros" exec="static_transform_publisher"
        args="0.0 -1.0 0.0 0 0 0 nusim/world purple/odom"/>

    <node pkg="tf2_ros" exec="static_transform_publisher"
        args="0.25 0.0 0.0 0 0 0 nusim/world red/odom"/>

    <node pkg="tf2_ros" exec="static_transform_publisher"
        args="0.0 0.5 0.0 0 0 0 nusim/world green/odom"/>

    <node pkg="tf2_ros" exec="static_transform_publisher"
        args="-0.5 0.0 0.0 0 0 0 nusim/world blue/odom"/>

    <node pkg="rviz2" exec="rviz2" args="-d $(find-pkg-share nuturtle_description)/config/load_one.rviz" if="$(eval '\'$(var use_rviz)\'== \'true\'')" />
</launch>
